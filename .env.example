# Images published by .github/workflows/docker-publish.yml
EBK_IMAGE=ghcr.io/yaho7/ezbookkeeping:latest
BILL_IMPORTER_IMAGE=ghcr.io/yaho7/ezbookkeeping-email-bill-importer:latest
EBK_PORT=8080

# Change this before the first startup: openssl rand -hex 32
EBK_SECURITY_SECRET_KEY=replace-with-a-long-random-value

# Mailbox credentials. Use an IMAP app password, not the web-login password.
MAIL_USER=your-account@qq.com
MAIL_PASS=replace-with-imap-app-password
IMAP_SERVER=imap.qq.com
IMAP_PORT=993
# Require the mailbox provider's topmost SPF/DKIM result for cmbchina.com.
REQUIRE_AUTHENTICATION_RESULTS=true
# Comma-separated trusted Authentication-Results service domains; inferred for QQ.
TRUSTED_AUTHSERV_DOMAINS=qq.com

# Create an API token in ezBookkeeping after enabling the server above.
EBK_API_TOKEN=replace-with-ezbookkeeping-api-token

# Numeric IDs returned by the bundled ebktools scripts.
CMB_CREDIT_ACCOUNT_ID=1
CMB_DEBIT_ACCOUNT_ID=2
EXPENSE_CATEGORY_ID=3
INCOME_CATEGORY_ID=4

TZ=Asia/Shanghai
MAX_EMAILS=60
POLL_INTERVAL_SECONDS=3600
RUN_ONCE=false
